{
  "name": "thewall",
  "version": "1.0.0",
  "description": "TheWall image slideshow application",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "dev:node": "node --watch --env-file=.dev.vars server.js",
    "start": "node server.js",
    "deploy": "wrangler deploy",
    "test": "npm run test:unit && playwright test",
    "test:unit": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "fastify": "^5.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "wrangler": "^4.114.0"
  }
}
